rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function member(rachaId) {
      return signedIn() && exists(/databases/$(database)/documents/rachas/$(rachaId)/members/$(request.auth.uid));
    }
    function role(rachaId) {
      return get(/databases/$(database)/documents/rachas/$(rachaId)/members/$(request.auth.uid)).data.role;
    }
    function manager(rachaId) {
      return member(rachaId) && role(rachaId) in ['owner', 'organizer', 'assistant'];
    }
    function owner(rachaId) {
      return member(rachaId) && role(rachaId) == 'owner';
    }
    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      match /rachas/{rachaId} {
        allow read, create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && (request.auth.uid == uid || owner(rachaId));
      }
    }
    match /invites/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && getAfter(/databases/$(database)/documents/rachas/$(request.resource.data.rachaId)).data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && owner(resource.data.rachaId);
    }
    match /rachas/{rachaId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if member(rachaId);
      allow update: if owner(rachaId) || manager(rachaId);
      allow delete: if owner(rachaId);
      match /members/{uid} {
        allow read: if member(rachaId);
        allow create: if signedIn() && (
          owner(rachaId)
          || (
            uid == request.auth.uid
            && request.resource.data.role == 'player'
            && request.resource.data.inviteCode is string
            && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.rachaId == rachaId
            && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.active == true
          )
          || (
            uid == request.auth.uid
            && request.resource.data.role == 'owner'
            && getAfter(/databases/$(database)/documents/rachas/$(rachaId)).data.ownerUid == request.auth.uid
          )
        );
        allow update: if owner(rachaId);
        allow delete: if owner(rachaId) || (signedIn() && uid == request.auth.uid);
      }
      match /data/{documentId} {
        allow read: if member(rachaId);
        allow write: if manager(rachaId);
      }
    }
  }
}
